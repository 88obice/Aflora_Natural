# ═══════════════════════════════════════════════════════════════════════════
# PLANTILLA DE VARIABLES DE ENTORNO — Aflora Natural
# ═══════════════════════════════════════════════════════════════════════════
#
# Este archivo NO tiene valores reales: es la LISTA de todas las variables que
# el código lee. Sirve para dos cosas:
#
#   1. Desarrollo local: copialo como `.env` y completá solo lo que necesites
#      (Django, base de datos y poco más). El `.env` NUNCA se sube a GitHub.
#   2. Producción: es el checklist de qué cargar en el panel de variables del
#      host (hoy Railway). Ahí NO existe el archivo `.env` — el host inyecta
#      las variables directamente en el entorno.
#
# Cómo lo lee Django: settings.py hace load_dotenv('.env'). Si el archivo
# existe (tu PC) carga esos valores; si no existe (Railway) usa las del host.
# Mismo código, distinta fuente según dónde corra.
#
# LEYENDA:
#   [OBLIGATORIA]  sin esto la app no arranca o algo importante se rompe
#   [DORMIDA]      si está vacía, la función simplemente no aparece. Sin errores.
#   [OPCIONAL]     tiene un default razonable en el código
# ═══════════════════════════════════════════════════════════════════════════


# ── Django ─────────────────────────────────────────────────────────────────

# [OBLIGATORIA] Sin esto la app no levanta (settings.py usa os.environ, no getenv).
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# La de producción debe ser DISTINTA de la local y no compartirse nunca.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# [OPCIONAL] default False. En producción SIEMPRE False: con True se muestran
# los errores completos (y las credenciales) a cualquier visitante.
DEBUG=True

# [OPCIONAL] default localhost,127.0.0.1. Dominios desde los que se sirve el
# sitio, separados por coma. En producción: tudominio.cl,www.tudominio.cl
ALLOWED_HOSTS=localhost,127.0.0.1

# [OBLIGATORIA en producción] Sin esto fallan los formularios (POST) con HTTPS.
# Formato con esquema: https://tudominio.cl,https://www.tudominio.cl
CSRF_TRUSTED_ORIGINS=

# [OPCIONAL] default http://localhost:8000. Se usa para armar los links de los
# emails (confirmación de pedido, tracking, newsletter). Los emails los manda
# un comando sin request, así que no se puede deducir sola.
# En producción: https://tudominio.cl  — SIN barra al final.
BASE_URL=http://localhost:8000

# [OPCIONAL] default "Aflora Natural". Nombre del sitio (django.contrib.sites).
SITE_NAME=Aflora Natural

# [OPCIONAL] default 3600 (1 hora). HSTS: cuantos segundos el navegador se
# acuerda de que este dominio va SIEMPRE por HTTPS. Solo aplica con DEBUG=False.
# Subir a 31536000 (1 año) cuando el dominio definitivo lleve un tiempo estable.
SECURE_HSTS_SECONDS=3600

# [OPCIONAL] default False. Kill-switch de Google: con True TODO el sitio sale
# con noindex/nofollow. Dejar en True mientras haya productos de prueba y
# pasar a False el día del lanzamiento real.
SITE_NOINDEX=False


# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────
#
# Dos formas, y el código prefiere DATABASE_URL si existe:
#   - Local: las variables sueltas DB_*
#   - Railway/Render: inyectan DATABASE_URL solos, no hay que cargar nada.

DB_NAME=aflora_db
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ── Superusuario del admin ─────────────────────────────────────────────────
#
# [OBLIGATORIAS en producción] Las usa el comando `crear_superusuario`, que
# corre en CADA deploy (ver railway.toml → preDeployCommand). Sin ellas no se
# crea la cuenta y te quedás sin poder entrar a /admin/ ni a /gestion/.
# La contraseña tiene que ser larga: esta cuenta ve todos los pedidos.
SUPERUSER_NAME=
SUPERUSER_PASSWORD=
SUPERUSER_EMAIL=


# ── Pagos: Flow (pasarela principal) ───────────────────────────────────────
#
# [DORMIDA] Sin API_KEY + SECRET_KEY, Flow NO aparece en el checkout y todo
# cae a Mercado Pago. Se sacan del panel de Flow de la cuenta de la dueña.
#
# ⚠ Al pasar a llaves REALES hay que cambiar TAMBIÉN FLOW_API_URL. Si te
#   olvidás, seguís cobrando contra el sandbox — o sea, no cobrás de verdad.
#     Sandbox:    https://sandbox.flow.cl/api   (default del código)
#     Producción: https://www.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api


# ── Pagos: Mercado Pago ────────────────────────────────────────────────────
#
# Es el medio activo mientras Flow no tenga llaves.
# Sandbox: claves APP_USR- de la cuenta de prueba.
# Producción: claves de la cuenta vendedora de la dueña.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# [OBLIGATORIA en producción] Valida la firma de los webhooks de MP.
# Se saca en el panel de MP → Webhooks. Sin esto el webhook acepta
# notificaciones sin verificar quién las manda (queda un warning en los logs).
MP_WEBHOOK_SECRET=


# ── Pagos: transferencia bancaria ──────────────────────────────────────────
#
# [DORMIDA] Si BANCO_TITULAR está vacío, la opción no aparece en el checkout.
# Son los datos de la cuenta de la dueña, tal como los va a ver el cliente.
BANCO_TITULAR=
BANCO_RUT=
BANCO_NOMBRE=
BANCO_TIPO_CUENTA=
BANCO_NUMERO_CUENTA=
BANCO_EMAIL_AVISO=


# ── Email: envío por API HTTP (Brevo) — ESTO ES LO DE PRODUCCIÓN ───────────
#
# [OBLIGATORIA en producción] Railway bloquea el SMTP saliente en los planes
# bajos, así que en el server los emails salen por la API HTTP de Brevo
# (puerto 443). Si BREVO_API_KEY tiene valor, se usa este backend y se IGNORA
# toda la configuración SMTP de más abajo.
#
# ⚠ Si falta, el sitio arranca igual y sin dar error — pero no sale ni un
#   email: ni confirmaciones de pedido, ni recuperar contraseña, ni newsletter.
#   Es la variable más fácil de olvidar al mudar de host.
#
# Se saca en https://app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# [OBLIGATORIA si usás Brevo] Brevo exige que el remitente esté VERIFICADO en
# su panel; suele ser distinto del usuario SMTP. Si no se define, usa
# EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=


# ── Email: SMTP (respaldo / desarrollo) ────────────────────────────────────
#
# Solo se usa cuando BREVO_API_KEY está vacía. Los defaults son de Gmail (SSL
# puerto 465). Para ver los emails en la terminal sin mandar nada de verdad:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=tu_cuenta@gmail.com
# App Password de Google (16 caracteres), NO la contraseña normal de la cuenta.
EMAIL_HOST_PASSWORD=


# ── Avisos al administrador ────────────────────────────────────────────────
#
# [OPCIONAL] Quién recibe los emails de "nuevo pedido", las alertas de
# "pagado pero sin stock" (que requieren reembolso manual) y los errores 500.
# Si ADMIN_EMAIL está vacío, cae a DEFAULT_FROM_EMAIL.
ADMIN_NAME=Admin Aflora
ADMIN_EMAIL=


# ── Datos de contacto públicos ─────────────────────────────────────────────
#
# [OPCIONAL] Se inyectan en todos los templates (footer, contacto, checkout).
# Están centralizados acá para que no queden hardcodeados e inconsistentes.
CONTACTO_EMAIL=contacto@afloranat.com
CONTACTO_WHATSAPP=56989560937
CONTACTO_WHATSAPP_DISPLAY=+56 9 8956 0937
CONTACTO_INSTAGRAM=aflora_natural


# ── Imágenes: Cloudinary ───────────────────────────────────────────────────
#
# [OBLIGATORIA en producción] El disco del host es efímero: sin Cloudinary,
# las fotos de productos y los comprobantes de transferencia que suben los
# clientes DESAPARECEN en el siguiente deploy.
#
# En local dejala vacía: las imágenes van a la carpeta media/ y listo.
#
# OJO: es UNA sola variable con todo adentro, no tres sueltas. Se copia entera
# desde https://cloudinary.com → Settings → API Keys → "Copy URL".
# Formato: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=


# ── Parámetros de la tienda ────────────────────────────────────────────────

# [OPCIONAL] default 40000. Monto (CLP) desde el que el envío es gratis.
# Fuente única de verdad: antes estaba hardcodeado en tres archivos.
ENVIO_GRATIS_UMBRAL=40000

# [OPCIONAL] Foto del hero de la portada (ej. una URL de Cloudinary).
# Si está vacía, se muestra la ilustración SVG por defecto.
#
# Si es de Cloudinary, agregale las transformaciones f_auto,q_auto,w_1600
# justo después de /upload/ — sirve la imagen en WebP y al ancho justo, sin
# resubir nada. En esta portada la diferencia fue de ~2 MB a ~79 KB, que en
# un celular con datos es la diferencia entre esperar y no esperar:
#   .../image/upload/f_auto,q_auto,w_1600/v123456/mi-foto.png
HERO_IMAGEN_URL=


# ── Analytics ──────────────────────────────────────────────────────────────
#
# [DORMIDAS] Si están vacías, los snippets no se renderizan (sin tracking en
# desarrollo, que es lo que se quiere).
# GA4: analytics.google.com → propiedad → Streams → Measurement ID (G-XXXXXXX)
# Meta Pixel: business.facebook.com → Events Manager → Pixels → ID numérico
GA4_MEASUREMENT_ID=
META_PIXEL_ID=


# ── Monitoreo de errores (Sentry) ──────────────────────────────────────────
#
# [DORMIDA] Sin DSN, Sentry ni se carga. Tampoco se activa con DEBUG=True.
# Cuenta gratis en https://sentry.io → proyecto Django → copiar el DSN.
SENTRY_DSN=

# [OPCIONAL] default 0 = modo "solo errores", no mide performance (para no
# gastar la cuota gratis). Subir a 0.1 si algún día querés medir páginas lentas.
SENTRY_TRACES_RATE=0

# [OPCIONAL] default production. Etiqueta que Sentry usa para separar entornos.
ENVIRONMENT=development
